{
  "$comment": "向量化文本拼接规范。",

  "model": {
    "name": "BAAI/bge-base-zh-v1.5",
    "dims": 768,
    "max_tokens": 512,
    "normalize_embeddings": true,
    "query_instruction": "为这个句子生成表示以用于检索相关文章：",
    "cache_dir": ".hf-cache"
  },

  "text": {
    "separator": "\n",
    "skip_empty": true
  },

  "types": {
    "source": [
      "identity.name",
      "presentation.summary",
      "presentation.publisher"
    ],
    "evidence": [
      "identity.name",
      "presentation.raw_texts"
    ],
    "viewpoint": [
      "identity.name",
      "presentation.content",
      "presentation.explanation",
      "reasoning.steps[].to",
      "reasoning.narrative",
      "experience.content"
    ]
  }
}
