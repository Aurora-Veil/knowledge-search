# 复制成 .env 再填值：cp .env.example .env

# Elasticsearch
ES_ELASTIC_PASSWORD=change-me-superuser
KIBANA_PASSWORD=change-me-kibana-system
ES_URL=http://localhost:9200
ES_USER=knowledge_app
ES_PASSWORD=change-me-app-user

# 只在空数据目录上第一次启动 ES 集群时填，集群成型后必须清空
# ES_INITIAL_MASTER_NODES=es01,es02,es03

# Kibana 加密密钥：生成一次填到下面三行，之后不要改。不用先起栈，直接拿镜像跑：
#   docker run --rm docker.elastic.co/kibana/kibana:9.5.3 bin/kibana-encryption-keys generate -q
# 不启动 Kibana 也必须填：compose 会插值整个文件，跟 profile 无关。
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=change-me
KIBANA_REPORTING_KEY=change-me
KIBANA_SECURITY_KEY=change-me

# JWT 签名密钥
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# PostgreSQL。
# 容器 PG 写在 5433 上，避开原生 PG 的 5432
PG_DSN=postgresql://postgres:change-me@127.0.0.1:5433/knowledge_db
POSTGRES_PASSWORD=change-me

# 编码服务。留空则模型在 API 进程内加载，单进程直跑时够用，容器里要填。
ENCODER_URL=http://127.0.0.1:8020

# compose 由两个文件叠加而成
# 单独起 ES 集群时显式写 -f docker-compose.cluster.yml
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.cluster.yml;docker-compose.app.yml

# compose project 名，钉死成 98。卷名（98_certs）由它推导，两个工作树共用同一批卷与容器名。
# 不写则从目录名推导，9.8-auth 会推成 98-auth，ES 的 CA 会重新生成一次。
COMPOSE_PROJECT_NAME=98

# 下面都有默认值，一般不用写。
# BIND_ADDR=127.0.0.1           # 让局域网设备访问写 0.0.0.0。ES 9200 与 Kibana 5601 也受它管
# PG_PORT=5433
# API_PORT=8000
# ENCODER_PORT=8020
# MONGO_PORT=27017
# ES_PORT=9200
# KIBANA_PORT=5601
# WEB_WORKERS=4                 # API 进程数，见 app/config.py 的 _check_concurrency
# ES_SEARCH_WORKERS=6           # 每进程 ES 搜索并发，不写按 25/WEB_WORKERS 取
# PG_POOL_MAX=10                # 每进程 PG 连接池上限
# ES_HEALTH_TIMEOUT=2
# PG_HEALTH_TIMEOUT=2
# ES_REQUEST_TIMEOUT=10         # 单次检索给 ES 的秒数
# BIND_HOST=127.0.0.1           # 编码服务监听地址，容器里由 compose 覆盖成 0.0.0.0
# ENCODER_MAX_BATCH=32
# ENCODER_BATCH_WAIT_MS=5
# ENCODER_TIMEOUT_S=2
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
