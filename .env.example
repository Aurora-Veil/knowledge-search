ES_ELASTIC_PASSWORD=change-me-superuser
KIBANA_PASSWORD=change-me-kibana-system

ES_URL=http://localhost:9200

ES_USER=knowledge_app
ES_PASSWORD=change-me-app-user

# Kibana 加密密钥：新环境跑一次
#   docker exec -i kibana bin/kibana-encryption-keys generate -q
# 把输出填到下面三行。生成一次后不要改。
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=change-me
KIBANA_REPORTING_KEY=change-me
KIBANA_SECURITY_KEY=change-me

# ES_HEALTH_TIMEOUT=2
# PG_HEALTH_TIMEOUT=2
# ES_REQUEST_TIMEOUT=10        # 单次检索给 ES 的时间（秒）

# PostgreSQL —— 用户与搜索记录
PG_DSN=postgresql://postgres:change-me@localhost:5432/knowledge_db

# JWT —— 登录令牌签名密钥
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 独立编码服务 —— 留空则模型在 API 进程内加载（单进程时够用）
# 非空时先起 python -m embedding.server，再起 API
ENCODER_URL=http://127.0.0.1:8020
# ENCODER_PORT=8020
# ENCODER_MAX_BATCH=32       # 单批上限
# ENCODER_BATCH_WAIT_MS=5    # 合批窗口
# ENCODER_TIMEOUT_S=2        # 客户端超时，须短于服务端 5s 兜底

# 并发 —— 改之前先看 app/config.py 里的 _check_concurrency
# WEB_WORKERS=4              # API 进程数；>1 时 uvicorn 不能热重载
# ES_SEARCH_WORKERS=6        # 每进程 ES 搜索并发；不写就按 25/WEB_WORKERS 自动取
# PG_POOL_MAX=10             # 每进程 PG 连接池上限
